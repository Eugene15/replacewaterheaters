    {"key":"cost_factor_list","roles":["explain","answer"],"requiredSlots":["heading","intro","factors","callout"],"itemCount":{"min":4,"max":7},"mobileRule":"heading and list stack"},
    {"key":"content_grid","roles":["explain","prove","answer"],"requiredSlots":["eyebrow","heading","prose"],"headingMaxCharacters":75,"bodyMaxWords":360,"mobileRule":"heading precedes prose in one column"},
    {"key":"local_detail_section","roles":["prove","answer"],"requiredSlots":["heading","verifiedLocalFacts","sourceLinks"],"bodyMaxWords":300,"mobileRule":"single column; source links wrap"},
    {"key":"fact_list","roles":["explain","compare"],"requiredSlots":["items"],"itemCount":{"min":3,"max":6},"mobileRule":"full-width rows"},
    {"key":"area_directory","roles":["orient"],"requiredSlots":["publishedAreaLinks"],"itemCount":{"min":1,"max":20},"mobileRule":"auto-fit to one column when needed"},
    {"key":"city_list","roles":["orient"],"requiredSlots":["qualifiedCityNames"],"itemCount":{"min":1,"max":18},"mobileRule":"two-column list"},
