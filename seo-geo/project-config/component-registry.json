  "prohibitedPatterns": ["unregistered components without component-mapper update", "identical full-page component sequences across neighboring city pages", "nested card grids", "decorative technical panels that overstate minor details", "decorative numbering such as 01, 02, 03 or numbered badges", "automatic rendering of unknown field names"]
