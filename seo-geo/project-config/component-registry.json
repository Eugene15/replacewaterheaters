    {"key":"related_links","roles":["orient"],"requiredSlots":["descriptiveAnchors"],"itemCount":{"min":1,"max":4},"mobileRule":"wrap links"},
    {"key":"final_cta","roles":["convert"],"requiredSlots":["contextLabel","heading","phoneLink"],"headingMaxCharacters":52,"mobileRule":"stack heading and phone"},
    {"key":"site_footer","roles":["orient","convert"],"requiredSlots":["brandSummary","serviceLinks","contact","sitemap"],"mobileRule":"brand spans columns; links remain readable"},
    {"key":"mobile_cta","roles":["convert"],"requiredSlots":["callAction","requestAction"],"itemCount":{"min":2,"max":2},"mobileRule":"fixed two-action bar with safe tap targets"},
    {"key":"conversion_decision_fork","roles":["compare","explain","convert"],"requiredSlots":["question","lead","optionAHeading","optionABody","optionBHeading","optionBBody","decisionNote"],"itemCount":{"min":2,"max":2},"mobileRule":"options stack; labels remain buyer-facing; no decorative numbering"},
