    {"key":"same_location_scope_utility","roles":["compare","answer","convert"],"requiredSlots":["question","lead","staysOption","movesOption","unknownOption","decisionNote"],"itemCount":{"min":3,"max":3},"mobileRule":"choices wrap or stack with full buyer-facing labels"}
